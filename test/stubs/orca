#!/usr/bin/env bash
# Stand-in for the Orca CLI in tests. Logs each call to $ORCA_STUB/calls and answers from the files in $ORCA_STUB. `worktree set --comment` stores the comment in current.json, when there is one; a file $ORCA_STUB/set-fails makes `worktree set` fail.
set -euo pipefail
printf '%s\n' "$*" >> "$ORCA_STUB/calls"
comment_at=0
for ((i = 1; i <= $#; i++)); do [ "${!i}" != --comment ] || comment_at=$((i + 1)); done

case "$1 ${2:-}" in
  "status --json") [ ! -f "$ORCA_STUB/down" ] ;;
  "worktree current" | "worktree show") cat "$ORCA_STUB/current.json" ;;
  "worktree list") cat "$ORCA_STUB/list.json" ;;
  "worktree set")
    [ ! -f "$ORCA_STUB/set-fails" ] || { echo "orca stand-in: worktree set failed" >&2; exit 1; }
    if [ "$comment_at" -gt 0 ] && [ -f "$ORCA_STUB/current.json" ]; then
      jq --arg comment "${!comment_at}" '.result.worktree.comment = $comment' "$ORCA_STUB/current.json" > "$ORCA_STUB/current.json.new"
      mv "$ORCA_STUB/current.json.new" "$ORCA_STUB/current.json"
    fi
    ;;
  "repo set-base-ref") ;;
  "worktree rm") [ ! -f "$ORCA_STUB/rm-fails" ] || { jq -Rc '{ok: false, error: {message: .}}' "$ORCA_STUB/rm-fails"; exit 1; } ;;
  "worktree create")
    # Makes a real git worktree of the repo in the current folder, as Orca would.
    name=""
    while [ $# -gt 1 ]; do
      [ "$1" != --name ] || name="$2"
      shift
    done
    git worktree add -q -b "test/$name" "$HOME/worktrees/$name" >&2
    jq -cn --arg path "$HOME/worktrees/$name" '{result: {worktree: {id: "repo-1::\($path)", path: $path}}}'
    ;;
  "repo list") jq -c '{result: {repos: .}}' "$ORCA_STUB/repos.json" ;;
  "repo add")
    jq -c --arg path "$4" '. + [{id: "repo-\(length + 1)", path: $path}]' "$ORCA_STUB/repos.json" > "$ORCA_STUB/repos.json.new"
    mv "$ORCA_STUB/repos.json.new" "$ORCA_STUB/repos.json"
    jq -c '{result: {repo: .[-1]}}' "$ORCA_STUB/repos.json"
    ;;
  "skills install")
    shift 2
    while [ $# -gt 0 ]; do
      [ "$1" != --skill ] || { mkdir -p "$HOME/.agents/skills/$2"; echo "# stand-in $2" > "$HOME/.agents/skills/$2/SKILL.md"; }
      shift
    done
    ;;
  "automations list") jq -c '{result: {automations: .}}' "$ORCA_STUB/automations.json" ;;
  "automations create")
    jq -c --arg name "$4" '. + [{name: $name}]' "$ORCA_STUB/automations.json" > "$ORCA_STUB/automations.json.new"
    mv "$ORCA_STUB/automations.json.new" "$ORCA_STUB/automations.json"
    ;;
  *) echo "orca stand-in: no answer for '$*'; add it to test/stubs/orca" >&2; exit 64 ;;
esac
