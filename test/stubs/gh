#!/usr/bin/env bash
# Stand-in for gh in tests. Logs each call to $GH_STUB/calls. `gh pr view` prints $GH_STUB/pr-state; no such file means no pull request.
set -euo pipefail
printf '%s\n' "$*" >> "$GH_STUB/calls"

case "$1 ${2:-}" in
  "pr view") cat "$GH_STUB/pr-state" ;;
  *) echo "gh stand-in: no answer for '$*'; add it to test/stubs/gh" >&2; exit 64 ;;
esac
