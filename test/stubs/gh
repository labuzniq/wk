#!/usr/bin/env bash
# Stand-in for gh in tests. Logs each call to $GH_STUB/calls. `gh pr view` answers from $GH_STUB/pr.json; no such file means no pull request.
# `gh pr create` opens pull request 7 and writes that file.
set -euo pipefail
printf '%s\n' "$*" >> "$GH_STUB/calls"

case "$1 ${2:-}" in
  "pr view")
    case "${4:-} ${5:-} ${6:-}" in
      "--json state,reviewDecision --jq" | "--json state --jq") jq -r "$7" "$GH_STUB/pr.json" ;;
      *) echo "gh stand-in: unexpected call '$*'; teach test/stubs/gh the new form" >&2; exit 64 ;;
    esac
    ;;
  "pr create")
    echo '{"state": "OPEN", "reviewDecision": ""}' > "$GH_STUB/pr.json"
    echo "https://github.com/someone/legacy/pull/7"
    ;;
  *) echo "gh stand-in: no answer for '$*'; add it to test/stubs/gh" >&2; exit 64 ;;
esac
