#!/usr/bin/env bash
# Stand-in for gh in tests. Logs each call to $GH_STUB/calls and answers from the files in $GH_STUB. Pull request 7 lives in $GH_STUB/pr.json; no such file means no pull request.
# `gh pr create` opens it, or fails when $GH_STUB/fail-create exists. The repo owner and the signed-in user are "someone",
# unless $GH_STUB/owner or $GH_STUB/me say otherwise.
set -euo pipefail
printf '%s\n' "$*" >> "$GH_STUB/calls"
url=https://github.com/someone/legacy/pull/7

unknown() { echo "gh stand-in: no answer for '$*'; add it to test/stubs/gh" >&2; exit 64; }
pr_update() {
  jq "$@" "$GH_STUB/pr.json" > "$GH_STUB/pr.json.new"
  mv "$GH_STUB/pr.json.new" "$GH_STUB/pr.json"
}

case "$1 ${2:-}" in
  "pr view")
    all="$*"
    shift 2
    [ "${1:-}" = --json ] || shift
    [ "${1:-}" = --json ] || { echo "gh stand-in: unexpected call '$all'; teach test/stubs/gh the new form" >&2; exit 64; }
    [ -f "$GH_STUB/pr.json" ] || { echo "no pull requests found for this branch" >&2; exit 1; }
    if [ "${3:-}" = --jq ]; then jq -r "$4" "$GH_STUB/pr.json"; else jq -c . "$GH_STUB/pr.json"; fi
    ;;
  "pr list")
    [ "${3:-} ${5:-} ${6:-} ${7:-} ${8:-} ${9:-}" = "--head --state open --json url --jq" ] || { echo "gh stand-in: unexpected call '$*'" >&2; exit 64; }
    if [ "$(jq -r .state "$GH_STUB/pr.json" 2>/dev/null)" = OPEN ]; then echo "$url"; fi
    ;;
  "pr create")
    [ ! -f "$GH_STUB/fail-create" ] || { echo "gh stand-in: pull request creation failed" >&2; exit 1; }
    echo '{"state": "OPEN", "reviewDecision": ""}' > "$GH_STUB/pr.json"
    echo "$url"
    ;;
  "pr edit")
    [ "${4:-}" = --body-file ] || unknown "$@"
    pr_update --rawfile body "$5" '.body = $body'
    ;;
  "pr merge")
    [ "${4:-} ${5:-}" = "--squash --match-head-commit" ] && [ $# -eq 6 ] || unknown "$@"
    if [ -f "$GH_STUB/merge-error" ]; then cat "$GH_STUB/merge-error" >&2; exit 1; fi
    [ "$6" = "$(jq -r .headRefOid "$GH_STUB/pr.json")" ] || { echo "head commit does not match" >&2; exit 1; }
    [ -f "$GH_STUB/merge-queued" ] || pr_update '.state = "MERGED" | .mergeCommit = {oid: "abc1234def5678"}'
    ;;
  "repo view") cat "$GH_STUB/owner" 2>/dev/null || echo someone ;;
  "api user") cat "$GH_STUB/me" 2>/dev/null || echo someone ;;
  api\ *)
    shift
    filter="." endpoint=""
    while [ $# -gt 0 ]; do
      case "$1" in
        -H) shift 2 ;;
        --jq) filter="$2"; shift 2 ;;
        --paginate) shift ;;
        *) endpoint="$1"; shift ;;
      esac
    done
    case "$endpoint" in
      repos/*/pulls/*/files) jq -r "$filter" "$GH_STUB/files.json" ;;
      repos/*/contents/.workspace-kit.toml\?ref=*)
        [ -f "$GH_STUB/manifest.${endpoint##*ref=}" ] || { echo "gh: Not Found (HTTP 404)" >&2; exit 1; }
        cat "$GH_STUB/manifest.${endpoint##*ref=}"
        ;;
      repos/*/*) jq -n '{default_branch: "main"}' | jq -r "$filter" ;;
      *) unknown api "$endpoint" ;;
    esac
    ;;
  *) unknown "$@" ;;
esac
