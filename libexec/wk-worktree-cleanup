#!/usr/bin/env bash
# Removes each worktree of this project whose branch is merged and whose card has been completed for 14 days. Keeps the branch. Prints every worktree and why.
set -euo pipefail
dry_run=""
case "${1:-}" in
  "") ;;
  --dry-run) dry_run=1 ;;
  *) echo "usage: wk worktree-cleanup [--dry-run]" >&2; exit 2 ;;
esac
# shellcheck source=../lib/project.sh
. "$(dirname "$0")/../lib/project.sh" || { echo "worktree-cleanup: this folder is not in a git repo; run it inside a project" >&2; exit 1; }
if ! command -v orca >/dev/null || ! orca status --json >/dev/null 2>&1; then
  echo "worktree-cleanup: Orca is not running, so no worktree was checked; start Orca and run this again" >&2
  exit 1
fi

days=14
now=$(date +%s)
# One file per card: the time this command first saw the card completed. Orca does not report that time.
stamps="$state_dir/completed/$(path_key "$primary")"
mkdir -p "$stamps"

completed_days() {
  local stamp="$1" since
  since=$(cat "$stamp" 2>/dev/null || true)
  case "$since" in
    "" | *[!0-9]*) since=$now; echo "$now" > "$stamp" ;;
  esac
  echo $(( (now - since) / 86400 ))
}

merged() {
  local path="$1" branch="$2" base="$3" head
  head=$(git -C "$path" rev-parse HEAD 2>/dev/null) || return 1
  if [ "$base" != - ] && git -C "$path" merge-base --is-ancestor "$head" "$base" 2>/dev/null; then return 0; fi
  [ "$(cd "$path" && gh pr view "$branch" --json state,headRefOid --jq '.state + " " + .headRefOid' 2>/dev/null)" = "MERGED $head" ]
}

removed=0 kept=0 failed=0
keep() { kept=$((kept + 1)); echo "kept     $1: $2"; }

check() {
  local key="$1" id="$2" path="$3" branch="$4" base="$5" status="$6" name="$7" age why into="" out error stamp changes
  stamp="$stamps/$(path_key "$key")"
  if [ "$status" != completed ]; then
    rm -f "$stamp"
    keep "$name" "the card is $status, not completed"
    return 0
  fi
  age=$(completed_days "$stamp")
  if [ "$age" -lt "$days" ]; then keep "$name" "completed $age days ago; it is removed after $days days"; return 0; fi
  if [ ! -d "$path" ]; then keep "$name" "its folder $path is missing; remove the card in Orca"; return 0; fi
  if [ "$path" = "$root" ]; then keep "$name" "this command runs inside it; run it from the main checkout"; return 0; fi
  # git must see the worktree itself: a folder with a broken .git link would be answered by a repo above it, or by none.
  if [ "$(git -C "$path" rev-parse --show-toplevel 2>/dev/null)" != "$(cd "$path" && pwd -P)" ] || ! changes=$(git -C "$path" status --porcelain 2>/dev/null); then
    keep "$name" "git cannot read $path; open it and run \`git status\` to see why"
    return 0
  fi
  if [ -n "$changes" ]; then
    keep "$name" "it has uncommitted or untracked files; commit or delete them in $path"
    return 0
  fi
  if [ "$branch" = - ]; then keep "$name" "it is on no branch"; return 0; fi
  [ "$base" = - ] || into=" into ${base#refs/remotes/}"
  if ! merged "$path" "$branch" "$base"; then
    keep "$name" "branch $branch is not merged$into, and GitHub shows no merged pull request for its newest commit"
    return 0
  fi
  why="branch $branch is merged and the card was completed $age days ago; the branch stays"
  if [ -n "$dry_run" ]; then
    removed=$((removed + 1))
    echo "would remove  $name: $why"
  elif out=$(orca worktree rm --worktree "id:$id" --json 2>&1); then
    removed=$((removed + 1))
    rm -f "$stamp"
    echo "removed  $name: $why"
  else
    failed=1
    error=$(jq -r '.error.message // empty' <<<"$out" 2>/dev/null || true)
    keep "$name" "Orca did not remove it: ${error:-$out}"
  fi
}

if ! listing=$(orca worktree list --repo "path:$primary" --limit 1000 --json 2>&1) || ! jq -e '.result.worktrees | type == "array"' <<<"$listing" >/dev/null 2>&1; then
  echo "worktree-cleanup: Orca did not list the worktrees of $primary, so none was checked. Its answer: $listing" >&2
  exit 1
fi
while IFS=$'\t' read -r -u 3 key id path branch base status name; do
  check "$key" "$id" "$path" "$branch" "$base" "$status" "$name"
done 3< <(jq -r '.result.worktrees[] | select(.isMainWorktree | not)
  | [.instanceId // .id, .id, .path, ((.branch // "") | sub("^refs/heads/"; "")), .baseRef, .workspaceStatus, .displayName]
  | map(if . == null or . == "" then "-" else . end) | @tsv' <<<"$listing")

if [ -n "$dry_run" ]; then
  echo "worktree-cleanup: would remove $removed, kept $kept; this was a dry run, nothing was removed"
else
  echo "worktree-cleanup: removed $removed, kept $kept"
fi
if [ "$(jq -r '.result.truncated' <<<"$listing")" = true ]; then
  echo "worktree-cleanup: Orca listed only a part of the worktrees of this project (more than 1000); the rest was not checked" >&2
  failed=1
fi
exit "$failed"
