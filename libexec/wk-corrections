#!/usr/bin/env bash
# Counts the vault's correction records. One line per record, tab-separated: <state> <key> <sessions> <layer> <note>.
# States: waiting (under three sessions), due (three or more), done (a commit carries "Correction: <key>"), broken.
set -euo pipefail
# shellcheck source=../lib/project.sh
. "$(dirname "$0")/../lib/project.sh" && [ -f "$manifest" ] \
  || { echo "wk corrections: no .workspace-kit.toml here; run it inside a project" >&2; exit 1; }
# shellcheck source=../lib/corrections.sh
. "$(dirname "$0")/../lib/corrections.sh"

due_at=3
vault=$(vault_dir)
newline=$'\n'
tab=$'\t'
checked=""

for record in "$vault"/wiki/corrections/*.md; do
  [ -f "$record" ] || continue
  key=${record##*/}
  key=${key%.md}
  # One awk per record keeps the doctor fast: the layer on the first line, then each session summary once.
  parsed=$(awk '
    { sub(/\r$/, "") }
    NR == 1 && $0 == "---" { inside = 1; next }
    !inside || $0 == "---" { exit }
    /^layer:/ { layer = $2; gsub(/["\047]/, "", layer) }
    /^[[:space:]]*-[[:space:]]*["\047]?raw\/sessions\// {
      sub(/^[[:space:]]*-[[:space:]]*/, ""); sub(/[[:space:]]+$/, ""); gsub(/["\047]/, "")
      if (!seen[$0]++) sessions = sessions "\n" $0
    }
    END { printf "%s%s\n", layer, sessions }' "$record")
  layer=${parsed%%"$newline"*}

  # A session that was resumed has two summaries that end in the same session id; it counts once.
  count=0 missing="" ids=" " newest=""
  if [ "$parsed" != "$layer" ]; then
    sessions=${parsed#*"$newline"}
    while IFS= read -r session; do
      name=${session##*/}
      name=${name%.md}
      case "$session" in *..*) missing="${missing:-$session}"; continue ;; esac
      [ -f "$vault/$session" ] || { missing="${missing:-$session}"; continue; }
      case "$ids" in *" ${name##*-} "*) continue ;; esac
      ids="$ids${name##*-} "
      count=$((count + 1))
      [[ ! "$name" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2} ]] || [[ ! "${name:0:10}" > "$newest" ]] || newest=${name:0:10}
    done <<SESSIONS
$sessions
SESSIONS
  fi

  state=waiting note="-"
  [ "$count" -lt "$due_at" ] || state=due
  if [[ ! "$key" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]]; then
    state=broken note="the file name must be a key of lowercase letters, digits and dashes; rename the file"
  elif [ -n "$missing" ]; then
    state=broken note="$missing is not a session summary in the vault; list only files that exist under raw/sessions/"
  elif [ "$count" -eq 0 ]; then
    state=broken note="the frontmatter lists no session summary; write \`sources:\` with one \`  - raw/sessions/<file>.md\` line per session"
  elif [[ ! "$layer" =~ ^(design|check|proof|prose)$ ]]; then
    state=broken note="layer must be design, check, proof or prose; set \`layer:\` to one of these words in the record's frontmatter"
  elif [ "$state" = due ]; then
    [ -n "$checked" ] || checked="$newline$(correction_commits "$root")$newline"
    case "$checked" in *"$newline$key "*)
      commit=${checked#*"$newline$key "}
      commit=${commit%%"$newline"*}
      # A session newer than the check means the check missed the mistake: due again.
      if [[ "$newest" > "${commit#* }" ]]; then note="after ${commit%% *}"; else state="done" note=${commit%% *}; fi ;;
    esac
  fi
  printf '%s\t%s\t%s\t%s\t%s\n' "$state" "${key//$tab/ }" "$count" "${layer:--}" "$note"
done
