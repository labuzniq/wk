#!/usr/bin/env bash
# Moves Orca cards forward from git, pull request and issue state, and brings new issue comments to the card. Never moves a card back from completed.
set -euo pipefail
command -v orca >/dev/null && orca status --json >/dev/null 2>&1 || exit 0

gh_interval_seconds=600
state_dir="$HOME/.local/state/workspace-kit/gh"
mkdir -p "$state_dir"

fresh() { [ -e "$1" ] && [ $(( $(date +%s) - $(stat -f %m "$1") )) -lt "$gh_interval_seconds" ]; }
stamp_of() { echo "$state_dir/$(printf '%s' "$1" | shasum | cut -d' ' -f1)"; }
# claim <folder>: true for one copy of this script at a time; a folder left behind by a killed copy is taken over after 10 minutes.
claim() { mkdir "$1" 2>/dev/null || { ! fresh "$1" && rmdir "$1" 2>/dev/null && mkdir "$1" 2>/dev/null; }; }

# pr_json <path> <branch>: prints what GitHub knows about the branch's pull request; nothing when there is none, when gh fails or when an answer came less than 10 minutes ago.
pr_json() {
  local path="$1" branch="$2" stamp
  git -C "$path" rev-parse -q --verify "refs/remotes/origin/$branch" >/dev/null || return 0
  stamp=$(stamp_of "$path")
  ! fresh "$stamp" || return 0
  touch "$stamp"
  # No answer is not remembered, so a pull request opened a minute later is seen on the next sync.
  (cd "$path" && gh pr view "$branch" --json state,reviewDecision,body,closingIssuesReferences 2>/dev/null) || rm -f "$stamp"
}

# name_issue <path> <branch> <issue> <pull request JSON>: an open pull request that does not name the card's issue gets "Closes #<issue>" added to its body, so the merge closes the issue.
# Done once per worktree: an owner who takes the line out again keeps it out.
name_issue() {
  local path="$1" branch="$2" issue="$3" pr="$4" body named
  named="$(stamp_of "$path").named"
  [ ! -e "$named" ] || return 0
  body=$(jq -r --argjson issue "$issue" '
    select(.state == "OPEN")
    | select(any(.closingIssuesReferences[]?; .number == $issue) | not)
    | select((.body // "") | test("\\b(close[sd]?|fix(e[sd])?|resolve[sd]?):?\\s+#\($issue)\\b"; "i") | not)
    | [((.body // "") | sub("\\s+$"; "") | select(. != "")), "Closes #\($issue)"] | join("\n\n")' <<<"$pr" 2>/dev/null) || return 0
  [ -n "$body" ] || return 0
  (cd "$path" && gh pr edit "$branch" --body "$body" >/dev/null 2>&1) || return 0
  touch "$named"
  echo "$branch: added 'Closes #$issue' to the pull request, so the merge closes the issue"
}

# follow_issue <card id> <path> <issue> <card created, ms>: sets issue_state, and adds each issue comment written after the card was created to the card comment, once.
# The stamp file holds the ids of the comments already added. Only the text of a project member is copied: the card comment is shown to the agent.
follow_issue() {
  local id="$1" path="$2" issue="$3" created="$4" stamp json new comment
  issue_state=""
  [ "$issue" != 0 ] || return 0
  stamp="$(stamp_of "$path").issue"
  ! fresh "$stamp" || return 0
  touch "$stamp"
  json=$(cd "$path" && gh issue view "$issue" --json state,comments 2>/dev/null) || return 0
  issue_state=$(jq -r '.state // empty' <<<"$json" 2>/dev/null) || return 0
  [ "$created" != 0 ] || return 0
  new=$(jq -r --rawfile added "$stamp" --argjson created "$created" '
    ($added | split("\n")) as $added
    | .comments[]
    | select(.id as $id | $added | index($id) | not)
    | select((.createdAt | sub("\\.[0-9]+"; "") | fromdateiso8601) * 1000 > $created)
    | (if (.authorAssociation // "") | test("^(OWNER|MEMBER|COLLABORATOR)$")
       then (.body // "") | gsub("[\\p{Cc}\\s]+"; " ") | .[0:200]
       else "(not a member of the project; text not copied)" end) as $text
    | "\(.id)\tissue comment by \(.author.login // "unknown" | gsub("[^A-Za-z0-9_/\\[\\]-]"; "")): \($text)"' <<<"$json" 2>/dev/null) || return 0
  [ -n "$new" ] || return 0
  comment=$(orca worktree show --worktree "id:$id" --json 2>/dev/null | jq -r '.result.worktree | if . then .comment // "" else error("no card") end' 2>/dev/null) || return 0
  comment="${comment:+$comment
}$(cut -f2- <<<"$new")"
  orca worktree set --worktree "id:$id" --comment "$comment" --json >/dev/null 2>&1 || return 0
  cut -f1 <<<"$new" >> "$stamp"
  echo "$(basename "$path"): added $(wc -l <<<"$new" | tr -d ' ') comment(s) from issue #$issue to the card"
}

merged_into_base() {
  local path="$1" base="$2" head
  head=$(git -C "$path" rev-parse HEAD)
  git -C "$path" merge-base --is-ancestor "$head" "$base" || return 1
  [ -z "$(git -C "$path" rev-list --first-parent "$base" | grep "^$head$" || true)" ]
}

# A completed card still gets new issue comments; its status is left alone.
sync_claimed() {
  local id="$1" path="$2" branch="${3#refs/heads/}" base="$4" status="$5" issue="$6" created="$7" pr_json pr="" target=""
  follow_issue "$id" "$path" "$issue" "$created"
  [ "$status" != completed ] || return 0
  pr_json=$(pr_json "$path" "$branch")
  if [ -n "$pr_json" ]; then
    pr=$(jq -r '.state + " " + .reviewDecision' <<<"$pr_json" 2>/dev/null)
    [ "$issue" = 0 ] || name_issue "$path" "$branch" "$issue" "$pr_json"
  fi
  if [[ "$pr" == MERGED* ]] || merged_into_base "$path" "$base" || [ "$issue_state" = CLOSED ]; then
    target=completed
  elif [[ "$pr" == "OPEN CHANGES_REQUESTED" ]]; then
    target=in-progress
  elif [[ "$pr" == OPEN* ]]; then
    target=in-review
  elif [ "$status" = todo ] && { [ -n "$(git -C "$path" status --porcelain)" ] || [ "$(git -C "$path" rev-list --count "$base..HEAD")" -gt 0 ]; }; then
    target=in-progress
  fi
  [ -z "$target" ] || [ "$target" = "$status" ] || orca worktree set --worktree "id:$id" --workspace-status "$target" --json >/dev/null
}

# One copy of this script works on a card at a time, and a card that fails does not stop the cards after it.
sync_card() {
  local lock
  lock="$(stamp_of "$2").lock"
  claim "$lock" || return 0
  sync_claimed "$@" || true
  rmdir "$lock"
}

current=$(orca worktree current --json 2>/dev/null) || exit 0
cards_dir="$HOME/.local/state/workspace-kit/cards"
mkdir -p "$cards_dir"
printf '%s\n' "$current" > "$cards_dir/$(printf '%s' "$(jq -r '.result.worktree.path' <<<"$current")" | shasum | cut -d' ' -f1).json"
if [ "${1:-}" = --repo ]; then
  cards=$(orca worktree list --repo "id:$(jq -r '.result.worktree.repoId' <<<"$current")" --json | jq -c '.result.worktrees[]')
else
  cards=$(jq -c '.result.worktree' <<<"$current")
fi

while IFS=$'\t' read -r id path branch base status issue created; do
  sync_card "$id" "$path" "$branch" "$base" "$status" "$issue" "$created"
done < <(jq -r 'select(.isMainWorktree | not) | select(.baseRef != null) | [.id, .path, (.branch // "" | if . == "" then "-" else . end), .baseRef, .workspaceStatus, (.linkedIssue // 0), (.createdAt // 0)] | @tsv' <<<"$cards")
