#!/usr/bin/env bash
# Prints one line per capsule gap: "<check_id>: <what is missing>". Prints nothing when the capsule is complete.
set -euo pipefail
# shellcheck source=../lib/project.sh
. "$(dirname "$0")/../lib/project.sh" || exit 0
# shellcheck source=../lib/config.sh
. "$(dirname "$0")/../lib/config.sh"
# shellcheck source=../lib/checksum.sh
. "$(dirname "$0")/../lib/checksum.sh"

if [ ! -f "$manifest" ]; then
  if [ -f "$state_dir/capsule-pr/$(path_key "$primary")" ]; then
    echo "manifest: the capsule is offered as $(sed -n 2p "$state_dir/capsule-pr/$(path_key "$primary")"); nothing to fix until that pull request is merged"
  elif [ ! -f "$state_dir/declined/$(path_key "$primary")" ]; then
    echo "manifest: no .workspace-kit.toml; run \`wk adopt\`"
  fi
  exit 0
fi
# A capsule that is still on its branch, waiting for the merge, has nothing to fix yet.
[ "$root" = "$primary" ] || [ -f "$primary/.workspace-kit.toml" ] || exit 0

skipped() { awk '/^\[skip\]/{s=1;next} /^\[/{s=0} s' "$manifest" | grep -q "^$1 *="; }
gap() { skipped "$1" || echo "$1: $2"; }

[ -n "$(manifest_value slug)" ] && [ -n "$(manifest_value type)" ] || gap manifest ".workspace-kit.toml lacks slug or type; run \`wk adopt\`"
[ -f "$root/CLAUDE.md" ] || gap claude_md "no project CLAUDE.md; run \`wk adopt\`, then fill in purpose, commands and gotchas from the repo"
grep -qs '^\[tasks\.setup\]' "$root/mise.toml" || gap mise "mise.toml has no setup task"
[ -n "$(manifest_value orca_repo_id)" ] || gap orca_repo "repo is not registered in Orca; run \`wk adopt\`"
[ -f "$root/orca.yaml" ] && [ -f "$root/.worktreeinclude" ] || gap orca_files "orca.yaml or .worktreeinclude is missing; run \`wk adopt\`"
grep -qs '^  setup:' "$root/orca.yaml" || gap orca_setup_hook "orca.yaml has no scripts.setup; add \`mise trust -y && mise run setup\`"

vision_file=""
[ -f "$root/VISION.md" ] && vision_file=VISION.md
[ -z "$vision_file" ] && grep -qsi '^#.*vision' "$root/STRATEGY.md" && vision_file=STRATEGY.md
if [ -n "$vision_file" ]; then
  committed=$(git -C "$root" log -1 --format=%ct -- "$vision_file")
  if [ -n "$committed" ] && [ $(( ($(date +%s) - committed) / 86400 )) -gt "$(manifest_value refresh_days)" ]; then
    gap vision_fresh "$vision_file is older than $(manifest_value refresh_days) days; needs the user: after their request is handled, offer to refresh it with the \`vision\` skill"
  fi
else
  commits=$(git -C "$root" rev-list --count HEAD)
  marker="$state_dir/vision-deferred/$(path_key "$primary")"
  if [ "$commits" -ge "$(manifest_value min_commits)" ]; then
    gap vision "no vision yet; needs the user: after their request is handled, offer to run the \`vision\` skill with them"
  elif [ ! -f "$marker" ]; then
    mkdir -p "$(dirname "$marker")" && touch "$marker"
    gap vision "deferred until $(manifest_value min_commits) commits (now $commits); the newest spec is the guidance until then. Nothing to fix."
  fi
fi

[ -f "$root/docs/agents/issue-tracker.md" ] || gap matt_setup "no docs/agents/issue-tracker.md; run \`wk adopt\`"
[ ! -f "$root/docs/agents/issue-tracker.md" ] || grep -q '^## Orca workspaces' "$root/docs/agents/issue-tracker.md" || gap tracker "docs/agents/issue-tracker.md treats Orca workspaces as tickets; delete it and run \`wk adopt\`, so tickets are issues and a workspace is created only when work starts"
[ ! -f "$primary/.workspace-kit.toml" ] || [ -f "$state_dir/automations/$(path_key "$primary")" ] || gap automations "the wiki automations are not created yet; run \`wk adopt\` in $primary"
[ ! -f "$state_dir/automations/$(path_key "$primary")" ] || grep -q '^Worktree cleanup: ' "$state_dir/automations/$(path_key "$primary")" || gap cleanup_automation "no daily worktree cleanup automation for this project; run \`wk adopt\` in $primary"
[ -f "$(vault_dir)/wiki/overview.md" ] || gap vault_page "no $(manifest_value vault)/wiki/overview.md in the vault; run \`wk adopt\`"

for skill in "$HOME/.agents/skills"/*/; do
  [ -d "$skill" ] || continue
  [ -e "$HOME/.claude/skills/$(basename "$skill")/SKILL.md" ] || { gap skills_visible "$(basename "$skill") is not visible to Claude Code; re-run install.sh"; break; }
done

kit_dir=$(wk_config kit)
skills_lock="$kit_dir/skills.lock"
if locked_skills=$(jq -r '.skills | keys | join(" ")' "$skills_lock" 2>/dev/null); then
  # shellcheck disable=SC2086 # one skill name per word; skills-sync allows no other characters in a name
  [ -z "$locked_skills" ] || [ "$(skills_sha256 $locked_skills)" = "$(jq -r '.installed_sha256' "$skills_lock")" ] \
    || gap skills "installed skills differ from skills.lock; run \`wk skills-sync\`"
else
  gap skills "skills.lock is missing or broken; run \`wk skills-sync\`"
fi

lock="$kit_dir/agents/agents.lock"
expected=$(jq -r '.agents | to_entries[] | .value.installed_sha256 + "  " + .key' "$lock" | sort)
actual=$(cd "$HOME/.claude/agents/ecc" 2>/dev/null && shasum -a 256 -- *.md | sed 's/\.md$//' | sort)
[ "$expected" = "$actual" ] || gap agents "installed ECC agents differ from agents.lock; run \`wk agents-sync\`"

for patch in "$kit_dir"/patches/skills/*.patch "$kit_dir"/patches/agents/*.patch; do
  [ -f "$patch" ] || continue
  kind=$(basename "$(dirname "$patch")")
  name=$(basename "$patch" .patch)
  case "$kind" in skills) patch_lock=$skills_lock ;; *) patch_lock=$lock ;; esac
  recorded=$(jq -r --arg kind "$kind" --arg name "$name" '.[$kind][$name].patch_sha256 // ""' "$patch_lock" 2>/dev/null || true)
  [ "$(shasum -a 256 < "$patch" | cut -d' ' -f1)" = "$recorded" ] || gap patches "patches/$kind/$name.patch is not applied; run \`wk $kind-sync\`"
done

proposals=$(ls "$(vault_dir)/wiki/_proposals"/*.md 2>/dev/null || true)
[ -z "$proposals" ] || gap proposals "needs the user: show each pending proposal and ask apply or reject: ${proposals//$'\n'/ }"
