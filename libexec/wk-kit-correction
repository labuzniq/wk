#!/usr/bin/env bash
# Corrections seen across projects, counted in the shared vault. No argument: one line per record, tab-separated: <state> <key> <projects> <layer> <note>.
# States: waiting (under three projects), due, offered (a pull request against the kit), done (a kit commit carries "Correction: <key>"), broken.
# `add <key>`: count this project in the record. `start <key>`: clone the kit for the fix. `offer <key>`: push the clone's one commit as a pull request.
set -euo pipefail
lib="$(cd "$(dirname "$0")/../lib" && pwd)"
# shellcheck source=../lib/config.sh
. "$lib/config.sh"
# shellcheck source=../lib/corrections.sh
. "$lib/corrections.sh"
state_dir="$HOME/.local/state/workspace-kit"
offers="$state_dir/kit-corrections"
due_at=3
newline=$'\n'
tab=$'\t'

fail() { echo "wk kit-correction: $1" >&2; exit 1; }
vault=$(wk_config shared_vault 2>/dev/null) && [ -d "$vault" ] || fail "there is no shared vault yet; run \`wk shared-vault\`"
records="$vault/wiki/corrections"
kit=$(wk_config kit)

# projects_of <record>: the layer on the first line, then each project id of the frontmatter's `projects:` list once.
projects_of() {
  awk '
    { sub(/\r$/, "") }
    NR == 1 && $0 == "---" { inside = 1; next }
    !inside || $0 == "---" { exit }
    /^[^[:space:]-][^:]*:/ { list = $1 }
    /^layer:/ { layer = $2; gsub(/["\047]/, "", layer) }
    list == "projects:" && /^[[:space:]]*-[[:space:]]*/ {
      sub(/^[[:space:]]*-[[:space:]]*/, ""); sub(/[[:space:]]+$/, ""); gsub(/["\047]/, "")
      if (!seen[$0]++) ids = ids "\n" $0
    }
    END { printf "%s%s\n", layer, ids }' "$1"
}

# list [key]: the line of every record, or of one.
list() {
  local record key parsed layer count ids state note checked="" commit id
  for record in "$records"/*.md; do
    [ -f "$record" ] || continue
    key=${record##*/}
    key=${key%.md}
    [ -z "${1:-}" ] || [ "$key" = "$1" ] || continue
    parsed=$(projects_of "$record")
    layer=${parsed%%"$newline"*}
    ids="" count=0 note="-"
    [ "$parsed" = "$layer" ] || ids=${parsed#*"$newline"}
    for id in $ids; do
      [[ "$id" =~ ^[0-9a-f]{12}$ ]] || { note="$id is not a project id; list only ids that \`wk kit-correction add\` wrote"; break; }
      count=$((count + 1))
    done
    state=waiting
    [ "$count" -lt "$due_at" ] || state=due
    if [[ ! "$key" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]]; then
      state=broken note="the file name must be a key of lowercase letters, digits and dashes; rename the file"
    elif [ "$note" != - ]; then
      state=broken count=0
    elif [ "$count" -eq 0 ]; then
      state=broken note="the frontmatter lists no project; run \`wk kit-correction add $key\` in each project the correction was seen in"
    elif [[ ! "$layer" =~ ^(design|check|proof|prose)$ ]]; then
      state=broken note="layer must be design, check, proof or prose; set \`layer:\` to one of these words in the record's frontmatter"
    elif [ "$state" = due ]; then
      [ -n "$checked" ] || checked="$newline$(correction_commits "$kit")$newline"
      case "$checked" in
        *"$newline$key "*)
          commit=${checked#*"$newline$key "}
          state="done" note=${commit%% *}
          ;;
        *) [ ! -s "$offers/$key" ] || { state=offered note=$(cat "$offers/$key"); } ;;
      esac
    fi
    printf '%s\t%s\t%s\t%s\t%s\n' "$state" "${key//$tab/ }" "$count" "${layer:--}" "$note"
  done
}

# due <key>: stop unless the record of the key is due.
due() {
  local line
  line=$(list "$1")
  [ -n "$line" ] || fail "no shared record $records/$1.md"
  [ "${line%%"$tab"*}" = due ] || fail "'$1' is ${line%%"$tab"*}, not due: $(printf '%s' "$line" | tr '\t' ' ')"
}

check_key() { [[ "${1:-}" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || fail "'${1:-}' is not a key; name the record's file without .md, such as \`uv-not-pip\`"; }

# add <key>: this project, by an id that names nothing, joins the record's `projects:` list.
add() {
  check_key "$1"
  local record="$records/$1.md" id count
  # shellcheck source=../lib/project.sh
  . "$lib/project.sh" && [ -f "$manifest" ] || fail "no .workspace-kit.toml here; run it inside a project"
  [ -f "$record" ] || fail "no shared record $record; write it first, the way \`corrections.md\` in the \`wiki-ingest\` skill says"
  # The first commit and the slug stand for the project: every clone shares them, and a checksum of them names nothing.
  id=$( { git -C "$primary" rev-list --max-parents=0 HEAD | sort | head -1; manifest_value slug; } | shasum -a 256 | cut -c1-12)
  if printf '%s\n' "$(projects_of "$record")" | tail -n +2 | grep -qx "$id"; then
    echo "kept    this project in $record"
    return
  fi
  awk -v id="$id" '
    NR == 1 && $0 == "---" { inside = 1; print; next }
    inside && !done && /^projects:/ { print; print "  - " id; done = 1; next }
    inside && !done && $0 == "---" { print "projects:"; print "  - " id; done = 1; inside = 0 }
    { print }' "$record" > "$record.new"
  mv "$record.new" "$record"
  count=$(list "$1" | cut -f3)
  echo "added this project to $record; it is seen in $count project$([ "$count" = 1 ] || echo s)"
}

origin_of_kit() { git -C "$kit" remote get-url origin 2>/dev/null || fail "the kit at $kit has no origin remote, so there is no repo to offer the fix to; add it with \`git -C $kit remote add origin <url>\`"; }

start() {
  check_key "$1"
  due "$1"
  local origin folder
  origin=$(origin_of_kit)
  folder=$(mktemp -d "${TMPDIR:-/tmp}/wk-kit-correction.XXXXXX")/kit
  git clone -q "$origin" "$folder" || fail "could not clone $origin; check the network and that \`git clone $origin\` works"
  git -C "$folder" switch -q -c "correction/$1"
  echo "cloned the kit into $folder on the branch correction/$1; write the fix there, commit it once with the last line \`Correction: $1\`, then run \`wk kit-correction offer $1\` in that folder"
}

# third_party <path> <clone>: a line naming the pinned skill or agent whose text the path is, if it is one.
third_party() {
  local path="$1" clone="$2" name
  case "$path" in
    skills/*/*)
      name=${path#skills/}
      name=${name%%/*}
      awk '{ for (i = 2; i <= NF; i++) print $i }' "$clone/skills.txt" | grep -qxF "$name" && echo "skill $name"
      ;;
    agents/*.md)
      name=${path#agents/}
      name=${name%.md}
      sed -n '/^\[agents\]/,/^\[/s/^\([A-Za-z0-9_-]*\) *=.*/\1/p' "$clone/agents/agents.toml" | grep -qxF "$name" && echo "agent $name"
      ;;
  esac
  return 0
}

offer() {
  check_key "$1"
  local key="$1" clone base count message path hit kind name branch="correction/$1" head pushed title layer projects body url
  if [ -s "$offers/$key" ]; then
    echo "kit-correction: '$key' was offered before as $(cat "$offers/$key"); nothing to do"
    return
  fi
  due "$key"
  clone=$(git rev-parse --show-toplevel 2>/dev/null) && [ "$(git -C "$clone" remote get-url origin 2>/dev/null)" = "$(origin_of_kit)" ] \
    || fail "$PWD is not a clone of the kit; run \`wk kit-correction start $key\` and run this in the folder it prints"
  [ -z "$(git -C "$clone" status --porcelain)" ] || fail "$clone has changes that are not committed; commit them into the fix, or remove them"
  git -C "$clone" fetch -q origin || fail "could not fetch from the kit's origin; check the network"
  base=$(git -C "$clone" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null) || fail "the clone does not know the kit's main branch; run \`git -C $clone remote set-head origin --auto\`"
  base=${base#origin/}
  count=$(git -C "$clone" rev-list --count "origin/$base..HEAD")
  [ "$count" -eq 1 ] || fail "the branch holds $count commits over origin/$base; the fix is one commit of its own, so it can be reverted alone: \`git reset --soft origin/$base\`, then commit once"
  message=$(git -C "$clone" log -1 --format=%B)
  [ "$(printf '%s\n' "$message" | sed '/^[[:space:]]*$/d' | tail -1)" = "Correction: $key" ] \
    || fail "the last line of the commit message must be \`Correction: $key\`; that line is how \`wk kit-correction\` knows the fix landed. Run \`git commit --amend\` and add it"
  while IFS= read -r path; do
    hit=$(third_party "$path" "$clone")
    [ -n "$hit" ] || continue
    kind=${hit%% *} name=${hit#* }
    fail "$path is text of the third-party $kind '$name'; the kit holds no copy of it. Write the fix as a recorded patch, patches/${kind}s/$name.patch (\"Good to know\" in README.md says how), and commit again"
  done <<<"$(git -C "$clone" diff --name-only "origin/$base" HEAD)"

  head=$(git -C "$clone" rev-parse HEAD)
  pushed=$(git -C "$clone" ls-remote --heads origin "$branch" | cut -f1)
  if [ -z "$pushed" ]; then
    git -C "$clone" push -q origin "HEAD:refs/heads/$branch" || fail "the push of $branch failed; nothing was offered"
  elif [ "$pushed" != "$head" ]; then
    fail "the kit's origin already has a branch $branch with another commit; look at it, delete it with \`git push origin --delete $branch\` when it is not wanted, and offer again"
  fi

  title=$(sed -n 's/^# //p' "$records/$key.md" | head -1)
  layer=$(list "$key" | cut -f4)
  projects=$(list "$key" | cut -f3)
  body=$(mktemp "${TMPDIR:-/tmp}/wk-kit-correction-body.XXXXXX")
  {
    printf '## Summary\n\nA correction seen in %s projects, offered to the kit by `wk kit-correction offer`.\n\n' "$projects"
    printf -- '- **The correction:** %s\n- **Cheapest layer:** %s\n- **Record:** `wiki/corrections/%s.md` in the shared vault\n\n' "$title" "$layer" "$key"
    printf '## Evidence\n\nThe commit message, with the check going red on the old mistake:\n\n````text\n%s\n````\n\n' "$(git -C "$clone" log -1 --format=%b)"
    printf '## Merge Danger\n\n**Door:** two-way\n**Blast Radius:** kit\n\nOne commit, `%s`. To undo it: close this pull request; after the merge, run `gh pr revert` on it.\n' "${head:0:7}"
  } > "$body"
  url=$(cd "$clone" && gh pr create --base "$base" --head "$branch" --title "$(git -C "$clone" log -1 --format=%s)" --body-file "$body" | tail -1) \
    || { rm -f "$body"; fail "the branch $branch is pushed, but \`gh pr create\` failed; run \`wk kit-correction offer $key\` here again"; }
  rm -f "$body"
  mkdir -p "$offers"
  echo "$url" > "$offers/$key"
  echo "kit-correction: offered $url for '$key', one commit (${head:0:7}); to undo it, close the pull request, or after the merge run \`gh pr revert $url\`"
}

case "${1:-}" in
  "") list ;;
  add | start | offer) "$1" "${2:-}" ;;
  *) echo "usage: wk kit-correction [add|start|offer <key>]" >&2; exit 2 ;;
esac
